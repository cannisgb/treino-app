# Copia para .env (local) ou define no Railway → serviço da app → Variables.
# IMPORTANTE: TODOS estes valores são NOVOS e exclusivos desta app.
# Nunca reutilizes os do Look Signature.

# Base de dados PRÓPRIA (no Railway, usa a referência ${{Postgres.DATABASE_URL}}
# do Postgres criado NO PROJETO DESTA APP).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/treino"

# Gera um novo: openssl rand -base64 32   (diferente do Look Signature!)
NEXTAUTH_SECRET="substitui-por-uma-string-longa-e-aleatoria"
# O endereço público desta app, sem barra no fim.
NEXTAUTH_URL="http://localhost:3000"

# O primeiro registo com este email fica TREINADOR. Todos os outros são clientes.
TRAINER_EMAIL="treinador@exemplo.com"

# Nome mostrado na app e no ícone do telemóvel.
NEXT_PUBLIC_APP_NAME="Treino"

# Opcional: emails (recuperar password, aviso de plano novo).
# Cria uma API key NOVA no Resend só para esta app.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Treino <treino@looksignature.pt>"
